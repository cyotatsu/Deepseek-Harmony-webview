{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:network_info_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            // DeepSeek 分享链接（https://chat.deepseek.com/share/...）
            //
            // 这条 skill 让应用能接住「华为分享 / 其它应用转发过来的分享链接」。
            // 关键点是 **domainVerify: false**：
            //
            //   · 该字段的含义（SDK 的 module.json schema 原文）：
            //     「true 表示该 ability 支持域名校验；false 表示**不**支持域名校验；
            //       该标签可选，**默认值为 false**」。
            //   · 之前这里写的是 true，即要求走 App Linking 的**域名校验**：
            //     系统会去 https://chat.deepseek.com/.well-known/ 拉取校验文件
            //     （assetlinks.json / applinking.json）核对应用身份。
            //     chat.deepseek.com 不是我们的域名、无法托管该校验文件，校验必然失败，
            //     于是链接被判定为「不属于本应用」，最终交给默认浏览器打开 ——
            //     这正是「通过华为分享接受后在浏览器打开」的原因。
            //   · 改为 false 后走**未校验**的 Deep Link：系统不再要求域名归属，
            //     直接按 uri 匹配到本应用；若同时有其它应用（如浏览器）也能处理，
            //     系统会给出选择。
            //
            // 这里显式写出 false（而不是依赖默认值），是为了让「不依赖域名校验」
            // 这个决定在配置里一眼可见，避免以后被误改回 true。
            //
            // 注意：网页里点同域链接仍然无法唤起本应用（实测结论，与 README 一致）——
            // 浏览器不会为普通 https 链接唤起应用，那是另一条路径，不在本 skill 范围内。
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "https",
                "host": "chat.deepseek.com",
                "pathStartWith": "/share"
              },
              {
                // 自定义 scheme：给「浏览器 / 其它应用把我拉起来」留一条可用通路。
                //
                // 为什么需要它：https 分享链接只有**通过域名校验（App Linking）**才能
                // 在浏览器之前抢到，而 chat.deepseek.com 不是我们的域名、无法托管校验文件，
                // 因此那条路在当前域名下走不通（实机实测：隐式 Want 投递该 https 链接
                // 会直接进浏览器，且不弹选择框）。自定义 scheme 不要求域名归属，
                // 未校验时按平台规则会走「多个应用匹配 ⇒ 弹选择框」，
                // 于是「用本应用打开该链接」这条提示才有可能出现。
                //
                // 形态与分享路径保持一致，便于逐段对应：
                //   deepseek://share/nj9g9k4zf1zxdwj8kx
                //   deepseek://chat.deepseek.com/share/nj9g9k4zf1zxdwj8kx
                // 两者都由 EntryAbility.handleDeepLink 归一化成
                // https://chat.deepseek.com/share/... 再交给 WebView 打开。
                "scheme": "deepseek",
                "pathStartWith": "share"
              }
            ],
            "domainVerify": false
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}
